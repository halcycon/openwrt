#!/bin/sh

. /lib/functions/system.sh

[ "$(board_name)" = "ubnt,usg-pro-4" ] || exit 0

get_usg_base_mac() {
	local part

	# Support images which expose a separate EEPROM MTD partition.
	part="$(find_mtd_part eeprom 2>/dev/null)"

	if [ -n "$part" ] && [ -e "$part" ]; then
		get_mac_binary "$part" 0
		return
	fi

	# Development-branch layout:
	# the complete 8 MiB NOR is /dev/mtd0 and the EEPROM region
	# begins at offset 0x140000.
	if [ -c /dev/mtd0 ]; then
		get_mac_binary /dev/mtd0 0x140000
	fi
}

base_mac="$(get_usg_base_mac)"

case "$base_mac" in
	""|00:00:00:00:00:00|ff:ff:ff:ff:ff:ff)
		logger -t usg-pro-4-macs \
			"Unable to read a valid factory MAC address"
		exit 1
		;;
esac

# Reject multicast base addresses.
first_octet="${base_mac%%:*}"

if [ $((0x$first_octet & 1)) -ne 0 ]; then
	logger -t usg-pro-4-macs \
		"EEPROM returned invalid multicast base MAC $base_mac"
	exit 1
fi

lan1_mac="$base_mac"
lan2_mac="$(macaddr_add "$base_mac" 1)"
wan1_mac="$(macaddr_add "$base_mac" 2)"
wan2_mac="$(macaddr_add "$base_mac" 3)"

case "$lan2_mac:$wan1_mac:$wan2_mac" in
	*::*)
		logger -t usg-pro-4-macs \
			"Failed to calculate interface MAC addresses"
		exit 1
		;;
esac

# Preserve values generated by the standard OpenWrt defaults.
ula_prefix="$(uci -q get network.globals.ula_prefix)"
dhcp_default_duid="$(uci -q get network.globals.dhcp_default_duid)"

# Use named sections throughout. Do not use @device indexes because
# their numbering changes as device sections are added.
cat > /etc/config/network <<NETWORK_EOF
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1/8'

config globals 'globals'

config device 'dev_lan1'
	option name 'lan1'
	option macaddr '$lan1_mac'

config device 'dev_lan2'
	option name 'lan2'
	option macaddr '$lan2_mac'

config device 'dev_wan1'
	option name 'wan1'
	option macaddr '$wan1_mac'

config device 'dev_wan2'
	option name 'wan2'
	option macaddr '$wan2_mac'

config device 'br_lan'
	option name 'br-lan'
	option type 'bridge'
	option macaddr '$lan1_mac'
	list ports 'lan1'
	list ports 'lan2'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1/24'
	option ip6assign '60'

config device 'br_wan'
	option name 'br-wan'
	option type 'bridge'
	option macaddr '$wan1_mac'
	list ports 'wan1'
	list ports 'wan2'

config interface 'wan'
	option device 'br-wan'
	option proto 'dhcp'

config interface 'wan6'
	option device 'br-wan'
	option proto 'dhcpv6'
NETWORK_EOF

[ -n "$ula_prefix" ] &&
	uci set "network.globals.ula_prefix=$ula_prefix"

[ -n "$dhcp_default_duid" ] &&
	uci set "network.globals.dhcp_default_duid=$dhcp_default_duid"

uci commit network

logger -t usg-pro-4-macs \
	"Applied factory MACs: lan1=$lan1_mac lan2=$lan2_mac wan1=$wan1_mac wan2=$wan2_mac"

exit 0
